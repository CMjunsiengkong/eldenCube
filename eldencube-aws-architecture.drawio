        <mxCell id="j2" value="&lt;span style=&quot;font-size:30px&quot;&gt;🔒&lt;/span&gt;&lt;br&gt;&lt;b&gt;S3, through the lock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#C9D1E8&quot;&gt;only on a cache miss&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#1F2850;strokeColor=#F2C14E;strokeWidth=2;fontSize=19;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="772" width="320" height="110" as="geometry"/></mxCell>
