        <mxCell id="title" parent="1" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" value="The Elden Cube — AWS Architecture" vertex="1">
          <mxGeometry height="40" width="1620" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#545B64;" value="A clumsy 3D boss-fight browser game, planned and built with &lt;b&gt;Kiro&lt;/b&gt; and hosted on &lt;b&gt;AWS&lt;/b&gt; as a static website. Booth attraction for AWS Student Community Day 2026 (Sat, 17 Oct 2026)." vertex="1">
          <mxGeometry height="40" width="1620" x="40" y="56" as="geometry" />
        </mxCell>
        <mxCell id="grpDev" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=#F7F7F7;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontColor=#232F3E;" value="&lt;b&gt;① BUILD &amp;amp; DEPLOY&lt;/b&gt; — Developer laptop" vertex="1">
          <mxGeometry height="580" width="360" x="40" y="120" as="geometry" />
        </mxCell>
