        </mxCell>
        <mxCell id="a1" parent="f1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;fontSize=12;fontColor=#232F3E;" value="Game waits on the &lt;b&gt;Title screen&lt;/b&gt;&lt;br&gt;boss idling, camera circling" vertex="1">
          <mxGeometry height="60" width="210" x="460" y="140" as="geometry" />
