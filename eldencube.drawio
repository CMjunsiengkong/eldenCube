        <mxCell id="playNote" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#232F3E;" value="&lt;b&gt;While playing&lt;/b&gt;&lt;br&gt;• No AWS calls at all&lt;br&gt;• No data stored (no login, no scores)" vertex="1">
