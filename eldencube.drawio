        <mxCell id="globalNote" parent="1" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;fontColor=#545B64;" value="Global services" vertex="1">
          <mxGeometry height="24" width="140" x="1030" y="300" as="geometry" />
        </mxCell>
        <mxCell id="cfn" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" value="&lt;b&gt;AWS CloudFormation&lt;/b&gt;&lt;br&gt;stack: EldenCubeStack&lt;br&gt;creates S3, CloudFront,&lt;br&gt;OAC and Budget" vertex="1">
