        <mxCell id="a2" parent="f1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;fontSize=12;fontColor=#232F3E;" value="Invite: &lt;i&gt;“Can you beat the Elden Cube?&lt;br&gt;One hit and you&#39;re dead.”&lt;/i&gt;" vertex="1">
