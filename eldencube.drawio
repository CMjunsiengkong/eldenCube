          <mxGeometry height="78" width="78" x="1061" y="360" as="geometry" />
        </mxCell>
        <mxCell id="budgets" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;" value="&lt;b&gt;AWS Budgets&lt;/b&gt;&lt;br&gt;emails an alert if cost&lt;br&gt;passes USD 5 / month" vertex="1">
          <mxGeometry height="78" width="78" x="1061" y="530" as="geometry" />
        </mxCell>
        <mxCell id="grpBooth" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=#F7F7F7;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontColor=#232F3E;" value="&lt;b&gt;④ PLAY&lt;/b&gt; — Booth laptop / any browser" vertex="1">
          <mxGeometry height="580" width="340" x="1320" y="120" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;spacingLeft=6;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" value="&lt;b&gt;Booth visitor&lt;/b&gt;&lt;br&gt;laptop keyboard + mouse" vertex="1">
          <mxGeometry height="78" width="78" x="1451" y="175" as="geometry" />
        </mxCell>
        <mxCell id="browser" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" value="&lt;b&gt;Web browser (Chrome)&lt;/b&gt;&lt;br&gt;the Three.js game runs&lt;br&gt;100% on the laptop" vertex="1">
          <mxGeometry height="76" width="78" x="1451" y="360" as="geometry" />
        </mxCell>
        <mxCell id="playNote" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#232F3E;" value="&lt;b&gt;While playing&lt;/b&gt;&lt;br&gt;• No AWS calls at all&lt;br&gt;• No data stored (no login, no scores)&lt;br&gt;• Offline fallback: run the local copy&lt;br&gt;&amp;nbsp;&amp;nbsp;with &lt;i&gt;npx vite preview&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="290" x="1345" y="540" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="kiro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;" target="vite" value="writes game + infra code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="vite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;" target="cdk" value="dist/ ready to upload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="cdk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="cfn" value="② synth &amp;amp; deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="cfn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s3" value="③ create bucket&lt;br&gt;+ upload dist/">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="cfn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="cloudfront" value="③ create distribution + clear cache">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="230" />
              <mxPoint x="1100" y="230" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="browser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="cloudfront" value="④ HTTPS GET&lt;br&gt;(once, on page load)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="cloudfront" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="s3" value="⑤ fetch on cache miss&lt;br&gt;(signed by OAC)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;" target="browser" value="plays with&lt;br&gt;WASD · Space · Click">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="noteWhat" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#1E88E5;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" value="&lt;b style=&quot;font-size:15px&quot;&gt;What is it?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The Elden Cube&lt;/b&gt; is a funny parody of a souls-like boss fight. A clumsy hero made of 6 geometric shapes swings an oversized sword at a giant cube wearing a crown.&lt;br&gt;&lt;br&gt;• One hit kills the player; the cube needs 5 hits&lt;br&gt;• 3 boss attacks, rage mode after hit 3&lt;br&gt;• Runs in any browser, no install, no login" vertex="1">
          <mxGeometry height="210" width="520" x="40" y="730" as="geometry" />
        </mxCell>
        <mxCell id="notePurpose" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3EDFB;strokeColor=#7E57C2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Purpose&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Attract&lt;/b&gt; visitors to the booth at AWS Student Community Day 2026&lt;br&gt;• &lt;b&gt;Introduce Kiro&lt;/b&gt;: the game was planned first (requirements → design → tasks), then built by Kiro — &lt;i&gt;&quot;plan before you build&quot;&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Promote AWS&lt;/b&gt;: a real game hosted on S3 + CloudFront, fully defined as code with the AWS CDK" vertex="1">
          <mxGeometry height="210" width="520" x="580" y="730" as="geometry" />
        </mxCell>
        <mxCell id="noteWhy" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF7E8;strokeColor=#7AA116;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Why this design?&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;About USD 0 / month&lt;/b&gt;: static files only, covered by the free allowance&lt;br&gt;• &lt;b&gt;Safe&lt;/b&gt;: no servers or APIs at runtime, so nothing to break or abuse&lt;br&gt;• &lt;b&gt;Secure&lt;/b&gt;: private bucket, readable only through CloudFront (OAC), HTTPS&lt;br&gt;• &lt;b&gt;Repeatable&lt;/b&gt;: one command deploys (&lt;i&gt;cdk deploy&lt;/i&gt;), one removes all (&lt;i&gt;cdk destroy&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Guarded&lt;/b&gt;: AWS Budgets alert at USD 5" vertex="1">
          <mxGeometry height="210" width="540" x="1120" y="730" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
