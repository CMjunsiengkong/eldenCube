  <diagram id="elden-cube-arch" name="Elden Cube Architecture">
    <mxGraphModel dx="1677" dy="1147" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" math="0" shadow="0" adaptiveColors="auto">
