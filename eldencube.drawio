        <mxCell id="n0" parent="f1" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#545B64;" value="Hook: the silly crowned cube and the big red “YOU DIED” screen draw a crowd. Keep the poster and architecture diagram visible." vertex="1">
          <mxGeometry height="60" width="420" x="990" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="f1" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#232F3E;" value="While they play, chat casually:&lt;br&gt;&lt;i&gt;“I planned and built this in about a week with Kiro.”&lt;/i&gt;" vertex="1">
