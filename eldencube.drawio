          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="cdk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="cfn" value="② synth &amp;amp; deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="cfn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s3" value="③ create bucket&lt;br&gt;+ upload dist/">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="cfn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="cloudfront" value="③ create distribution + clear cache">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="230" />
              <mxPoint x="1100" y="230" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="browser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="cloudfront" value="④ HTTPS GET&lt;br&gt;(once, on page load)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="cloudfront" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="s3" value="⑤ fetch on cache miss&lt;br&gt;(signed by OAC)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=default;fontColor=#232F3E;" target="browser" value="plays with&lt;br&gt;WASD · Space · Click">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="noteWhat" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#1E88E5;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" value="&lt;b style=&quot;font-size:15px&quot;&gt;What is it?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The Elden Cube&lt;/b&gt; is a funny parody of a souls-like boss fight. A clumsy hero swings an oversized sword at a giant crowned jelly cube in a moonlit stone ruin.&lt;br&gt;&lt;br&gt;• 3 HP and 3 flasks vs a 36-HP boss with 8 moves&lt;br&gt;• Rage at half HP: blood moon + meteor shower&lt;br&gt;• Runs in any browser, no install, no login" vertex="1">
          <mxGeometry height="180" width="800" x="40" y="730" as="geometry" />
        </mxCell>
        <mxCell id="noteWhy" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF7E8;strokeColor=#7AA116;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Why this design?&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;About USD 0 / month&lt;/b&gt;: static files only, covered by the free allowance&lt;br&gt;• &lt;b&gt;Safe&lt;/b&gt;: no servers or APIs at runtime, so nothing to break or abuse&lt;br&gt;• &lt;b&gt;Secure&lt;/b&gt;: private bucket, readable only through CloudFront (OAC), HTTPS&lt;br&gt;• &lt;b&gt;Repeatable&lt;/b&gt;: one command deploys (&lt;i&gt;cdk deploy&lt;/i&gt;), one removes all (&lt;i&gt;cdk destroy&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Guarded&lt;/b&gt;: AWS Budgets alert at USD 5" vertex="1">
          <mxGeometry height="180" width="800" x="860" y="730" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
