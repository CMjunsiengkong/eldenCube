        <mxCell id="t2" value="ONE CUBE. NO GAME ENGINE. PURE CODE." style="text;html=1;whiteSpace=wrap;fontSize=46;fontColor=#F2C14E;align=center;verticalAlign=middle;fontStyle=1;fontFamily=Cinzel;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DCinzel%3Awght%40700;" vertex="1" parent="1"><mxGeometry x="0" y="26" width="1920" height="62" as="geometry"/></mxCell>
        <mxCell id="t3" value="Everything you see, hear and dodge is built from code and runs live in your browser." style="text;html=1;whiteSpace=wrap;fontSize=21;fontColor=#C9D1E8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="1920" height="34" as="geometry"/></mxCell>
